# ============================================================================
# Celune Platform — Environment Variables
# ============================================================================
# Copy to .env.local and fill in values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ────────────────────────────────────────────────────────────────────
# Comma-separated OAuth providers to show (omit for all: github,google)
# NEXT_PUBLIC_AUTH_PROVIDERS=github,google

# ── Branding / Public URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_DOMAIN=                          # Your app host, e.g. app.example.com. Celune Cloud: app.celune.ai
NEXT_PUBLIC_MARKETING_DOMAIN=celune.ai
NEXT_PUBLIC_DOCS_DOMAIN=docs.celune.ai
NEXT_PUBLIC_SUPPORT_EMAIL=hello@celune.ai
NEXT_PUBLIC_PRODUCT_NAME=Celune                  # Product name shown in titles and emails
NEXT_PUBLIC_COOKIE_DOMAIN=                       # Optional; defaults to the parent of NEXT_PUBLIC_APP_DOMAIN (.celune.ai)
NEXT_PUBLIC_FONT_SANS=                           # Optional CSS font stack override; default is Inter
AGENT_MAIL_DOMAIN=                               # Optional; agent inbox domain, defaults to NEXT_PUBLIC_MARKETING_DOMAIN
CELUNE_API_KEY_PREFIX=celune                     # API keys look like <prefix>_live_<random>; keep `celune` for existing keys
# Self-hosts keep community. Celune Cloud sets CELUNE_EDITION=cloud explicitly on every environment.
CELUNE_EDITION=community                         # cloud | community. Unset: cloud when STRIPE_SECRET_KEY is set or the app domain is Celune's, else community
CELUNE_GATE_MODE=                                # cloud | noop. Unset: follows CELUNE_EDITION (cloud gate = suspension + plan limits)
# HS256 secret for host-minted JWTs (sub, workspace_id, scopes, exp) accepted by /api/v1 and /api/mcp.
# At least 32 bytes or the server refuses to start. Generate with: openssl rand -hex 32
CELUNE_HOST_JWT_SECRET=
CELUNE_HOST_JWKS_URL=                            # Or a JWKS URL for asymmetric host tokens; leave both unset to accept API keys only
# Optional. When set, host tokens must carry this iss and aud. The web app signs embed tokens with them
# and the API (apps/api, /api/v1, /api/mcp) checks them, so web and API must use the same values.
CELUNE_HOST_JWT_ISSUER=
CELUNE_HOST_JWT_AUDIENCE=
NEXT_PUBLIC_PLATFORM_REPO_URL=https://github.com/celune-ai/celune-platform
NEXT_PUBLIC_SLACK_CHANNEL_URL=

# ── CORS / CSRF ─────────────────────────────────────────────────────────────
# Comma-separated production origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# ── AI Provider API Keys ────────────────────────────────────────────────────
# Host fallback keys, read only on the cloud edition (CELUNE_EDITION=cloud) and
# only after the Gate allows provider.fallback_key. The community edition
# ignores these: every workspace brings its own keys in Settings > Provider Keys.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GOOGLE_GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=sk-...
# ELEVENLABS_API_KEY=xi-...

# Anthropic admin key — used for platform-level AI operations (onboarding, support chat)
# ANTHROPIC_ADMIN_API_KEY=sk-ant-...

# ── Provider Key Encryption (BYOK) ──────────────────────────────────────────
# Required when using Bring Your Own Key (BYOK) for AI providers. On the
# community edition this is required for any AI feature. Keys are stored with
# AES-256-GCM in provider_api_keys; per-workspace token and request caps live on
# workspaces.ai_token_limit_monthly / ai_requests_per_minute (Settings > Provider Keys).
# Generate with: openssl rand -hex 32
# PROVIDER_KEY_ENCRYPTION_KEY=              # Required when BYOK is enabled — primary encryption key (openssl rand -hex 32)
# PROVIDER_KEY_ENCRYPTION_KEY_V=           # For key rotation only — set new key here, move old to _KEY. Remove _V after re-encrypting all stored keys.
# HMAC-SHA256 key that signs job queue rows; the api service must use the same value.
# Generate with: openssl rand -hex 32
# JOB_HMAC_KEY=

# ── GitHub App (workspace-repo linking) ──────────────────────────────────────
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app/installations/new

# ── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Celune Cloud per-seat prices ($25/seat/mo monthly, $240/seat/yr annual)
STRIPE_PRICE_CLOUD_MONTHLY=price_...
STRIPE_PRICE_CLOUD_ANNUAL=price_...
# Optional: prices from before the Cloud plan. Subscriptions on them resolve to Cloud.
# STRIPE_PRICE_BUILD=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_UNLIMITED=price_...

# ── Slack Integration ────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=                      # Slack app signing secret for HMAC verification
SLACK_ALLOWED_USER_IDS=                    # Comma-separated Slack user IDs allowed to use /remote

# ── Discord Integration ──────────────────────────────────────────────────────
DISCORD_APPLICATION_ID=                    # Discord application/client ID (from discord.com/developers)
DISCORD_PUBLIC_KEY=                        # Ed25519 public key for interaction signature verification
DISCORD_BOT_TOKEN=                         # Bot token for sending messages and API calls
DISCORD_CLIENT_SECRET=                     # OAuth2 client secret for authorization code exchange
DISCORD_GATEWAY_SECRET=                    # Required when Discord gateway is deployed — shared HMAC secret (openssl rand -hex 32, must match discord-gateway env)

# ── Nango / Knowledge Integration ────────────────────────────────────────────
# OAuth-based knowledge source connections (Google Drive, Notion, etc.)
NANGO_HOST_URL=                            # Nango server URL (e.g. https://api.nango.dev)
NANGO_SECRET_KEY=                          # Nango secret key for API calls

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=                            # Resend API key for transactional emails
RESEND_FROM_EMAIL=                         # Sender address (e.g. notifications@celune.ai)

# ── AgentMail ────────────────────────────────────────────────────────────────
# AGENTMAIL_API_KEY=                       # AgentMail API key for agent email capabilities

# ── Webhook / Encryption ─────────────────────────────────────────────────────
# WEBHOOK_ENCRYPTION_KEY=                  # AES-256-GCM key for bot token encryption (openssl rand -hex 32)
# HOOK_SECRET=                             # Shared secret for hooks/notify endpoint

# ── Sentry ───────────────────────────────────────────────────────────────────
# SENTRY_AUTH_TOKEN=your-sentry-token
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_WEBHOOK_SECRET=                  # Sentry client secret for webhook HMAC verification

# ── Vercel ───────────────────────────────────────────────────────────────────
VERCEL_DEPLOY_HOOK=                        # Vercel deploy hook URL for /remote deploy command
# VERCEL_API_TOKEN=                        # Vercel API token for analytics/deploy status

# ── Cron / Scheduled Jobs ────────────────────────────────────────────────────
# CRON_SECRET=                             # Shared secret to authenticate cron job requests

# ── Health Check ─────────────────────────────────────────────────────────────
# HEALTH_PYTHON_PATH=                      # Path to Python binary for health scripts
# HEALTH_SCRIPT_PATH=                      # Path to health check script

# ── Billing Extras ───────────────────────────────────────────────────────────
# CLAUDE_MAX_RESET_DAY=                    # Day of month for Claude Max usage reset

# ── Vault ────────────────────────────────────────────────────────────────────
# ALLOWED_VAULT_ROOTS=                     # Comma-separated allowed vault root paths
