# apps/platform — required environment variables
# Copy this file to .env.local and fill in your values.
# Get all keys from: https://supabase.com/dashboard → Project Settings → API

# Supabase (public — safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase service role — SERVER SIDE ONLY. Never expose to browser.
# Bypasses Row Level Security. Used only in /api routes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Next.js base path (set to /app for admin app)
NEXT_PUBLIC_BASE_PATH=/app

# Anthropic API — used for Claude agent chat in /api/agents/[id]/chat
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Sentry — error tracking
# DSN from: https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project-id>

# Sentry — source map uploads (only needed in CI)
# Auth token from: https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_...
