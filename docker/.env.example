# Celune self-host stack: environment for docker/docker-compose.yml
#
# Easiest path: run `npx @celuneai/cli init --mode docker` from the repo root. It
# copies this file to docker/.env and fills every secret below with
# crypto-random values (it never prints them).
#
# Manual path: copy this file to docker/.env and fill each <generate> value.
#   hex 32 bytes:   openssl rand -hex 32
#   base64 48:      openssl rand -base64 48
#   ANON_KEY / SERVICE_ROLE_KEY are HS256 JWTs signed with JWT_SECRET:
#     payload {"role":"anon","iss":"supabase","iat":<now>,"exp":<now + 10 years>}
#     payload {"role":"service_role","iss":"supabase","iat":<now>,"exp":<now + 10 years>}
#   `npx @celuneai/cli init` produces both; the Supabase self-hosting guide has a generator too.
#
# Never commit docker/.env. It is gitignored and excluded from Docker builds.

# ── Edition ────────────────────────────────────────────────────────────────
# The compose file pins CELUNE_EDITION=community for api and web: no billing,
# no plan limits, no Stripe, BYOK-only AI (each workspace adds its own keys
# in Settings > Provider Keys).

# ── Public URLs and ports ──────────────────────────────────────────────────
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
APP_DOMAIN=localhost
SUPPORT_EMAIL=admin@localhost
WEB_PORT=3000
API_PORT=3010
KONG_HTTP_PORT=8000
POSTGRES_HOST_PORT=54322
STUDIO_PORT=54323

# ── Supabase secrets ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate: openssl rand -hex 32
JWT_SECRET=
# Token lifetime in seconds.
JWT_EXPIRY=3600
# Generate: HS256 JWT, role anon, signed with JWT_SECRET
ANON_KEY=
# Generate: HS256 JWT, role service_role, signed with JWT_SECRET
SERVICE_ROLE_KEY=
# Generate: openssl rand -base64 48
SECRET_KEY_BASE=
# Realtime encrypts its tenant settings with this key. It must be exactly 16
# characters. Generate: openssl rand -hex 8
REALTIME_DB_ENC_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────
# Email sign-in confirms accounts without mail by default so the first user
# can sign in. Set to false and fill SMTP_* to require confirmation.
ENABLE_EMAIL_AUTOCONFIRM=true
# Open sign-up is off, so strangers who reach the stack cannot create
# accounts. Create the first account as SETUP.md describes. Set to false only
# while people you trust sign up, then set it back and restart auth.
DISABLE_SIGNUP=true
ADDITIONAL_REDIRECT_URLS=
AUTH_PROVIDERS=email
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# ── Celune secrets ─────────────────────────────────────────────────────────
# AES-256-GCM key for workspace provider keys (BYOK) and job payloads.
# Generate: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_KEY=
# HMAC-SHA256 key that signs job queue rows. The web and api services must share it.
# Until it is set, jobs are signed with a subkey of PROVIDER_KEY_ENCRYPTION_KEY, and
# jobs signed that way still verify for one release after you set it.
# Generate: openssl rand -hex 32
JOB_HMAC_KEY=
# AES-256-GCM key for stored integration credentials.
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# HS256 secret for host-minted JWTs accepted by /v1 and /v1/mcp. The api and
# web services refuse to start when it is shorter than 32 bytes.
# Generate: openssl rand -hex 32
CELUNE_HOST_JWT_SECRET=
# Optional. A JWKS URL for host tokens signed with an asymmetric key, used with or
# instead of CELUNE_HOST_JWT_SECRET.
CELUNE_HOST_JWKS_URL=
# Optional. When set, host tokens must carry this iss and aud. The web service signs
# embed tokens with them and the api service checks them, so compose passes the same
# values to both.
CELUNE_HOST_JWT_ISSUER=
CELUNE_HOST_JWT_AUDIENCE=
# AES-256-GCM key for bot token encryption.
# Generate: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=
# Shared secrets for cron and hook endpoints.
# Generate: openssl rand -hex 32
CRON_SECRET=
# Generate: openssl rand -hex 32
HOOK_SECRET=
# Prefix for the API keys this install issues.
CELUNE_API_KEY_PREFIX=celune
