  },
  "dependencies": {
    "@celuneai/react": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5",
    "vite": "^7.3.1"
  }
}
