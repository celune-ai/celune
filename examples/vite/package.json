{
  "name": "@celuneai/example-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bare Vite app rendering the @celuneai/react tasks board against a mocked transport",
  "scripts": {
    "dev": "pnpm --filter @celuneai/react build && vite",
