{
  "name": "@celuneai/cli",
  "version": "1.1.0",
  "description": "Celune CLI: set up a self-hosted Celune and connect AI coding tools to it",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "celune": "dist/index.js"
  },
  "keywords": [
    "celune",
    "ai",
    "agents",
    "mcp",
    "cli",
    "cursor",
    "windsurf",
    "claude-code",
    "vscode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celune-ai/celune.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/celune-ai/celune#readme",
  "bugs": {
    "url": "https://github.com/celune-ai/celune/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fflate": "^0.8.2",
    "open": "^10.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
